# Private configuration outside release/web. Never commit a filled file.
HOST=127.0.0.1
PORT=443
APP_ORIGIN=https://your-domain.example
SESSION_SECRET=
SESSION_COOKIE_NAME=session
DATA_DIR=C:\Climb\data
LOG_DIR=C:\Climb\logs
TLS_KEY_FILE=C:\Climb\config\tls\private-key.pem
TLS_CERT_FILE=C:\Climb\config\tls\fullchain.pem
# Optional passphrase for an encrypted PEM key
TLS_KEY_PASSWORD=
COOKIE_SECURE=true
NODE_ENV=production
# WEB_ROOT is assigned from current.json by Start-Climb.ps1
